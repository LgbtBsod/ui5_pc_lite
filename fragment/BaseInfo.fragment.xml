<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core"
  xmlns:data="http://schemas.sap.com/sapui5/extension/sap.ui.core.CustomData/1">

  <Panel headerText="{i18n>hdrBaseInfo}" expandable="false" width="100%" class="appCard">
    <f:SimpleForm id="baseInfoForm"
                  editable="true"
                  layout="ResponsiveGridLayout"
                  columnsL="2" columnsM="2" columnsXL="3"
                  singleContainerFullSize="true"
                  class="appForm">
      <f:content>
        <Label text="{i18n>lblInspected}" labelFor="inspectedInput" class="appLabel"/>
        <Input id="inspectedInput"
               value="{formModel>/InspectedFullname}"
               placeholder="{i18n>phPersonSearch}"
               showSuggestion="true"
               suggestionItems="{path:'inspectedPersonModel>/items', parameters:{templateShareable:true}}"
               liveChange="onPersonLiveChange"
               suggestionItemSelected="onInspectedSelected"
               class="appInput"
               data:role="inspected">
          <suggestionItems>
            <core:Item text="{inspectedPersonModel>Fullname}" key="{inspectedPersonModel>Pernr}" />
          </suggestionItems>
        </Input>

        <Label text="{i18n>lblInspector}" labelFor="inspectorInput" class="appLabel"/>
        <Input id="inspectorInput"
               value="{formModel>/InspectorFullname}"
               placeholder="{i18n>phPersonSearch}"
               showSuggestion="true"
               suggestionItems="{path:'inspectorPersonModel>/items', parameters:{templateShareable:true}}"
               liveChange="onPersonLiveChange"
               suggestionItemSelected="onInspectorSelected"
               class="appInput"
               data:role="inspector">
          <suggestionItems>
            <core:Item text="{inspectorPersonModel>Fullname}" key="{inspectorPersonModel>Pernr}" />
          </suggestionItems>
        </Input>

        <!-- [Fix SSOT] valueFormat — constraintsModel (EntityConfig.CONSTRAINTS),
             тот же паттерн, что использует util/ODataFormat.js для парсинга,
             вместо независимой строки "yyyy-MM-dd"/"HH:mm:ss" здесь. -->
        <Label text="{i18n>lblCheckDate}" labelFor="checkDate" class="appLabel"/>
        <DatePicker id="checkDate" value="{formModel>/CheckDate}"
                    valueFormat="{constraintsModel>/DateValueFormat}" displayFormat="dd.MM.yyyy" width="100%"
                    class="appInput"/>

        <Label text="{i18n>lblCheckTime}" labelFor="checkTime" class="appLabel"/>
        <TimePicker id="checkTime" value="{formModel>/CheckTime}"
                    valueFormat="{constraintsModel>/TimeValueFormat}" displayFormat="HH:mm:ss" width="100%"
                    class="appInput"/>

        <Label text="{i18n>lblTimeZone}" labelFor="timeZone" class="appLabel"/>
        <ComboBox id="timeZone" selectedKey="{formModel>/TimeZone}"
                  items="{path:'dictionaryModel>/TIMEZONE', parameters:{templateShareable:true}}" width="100%" class="appInput">
          <core:Item key="{dictionaryModel>Code}" text="{dictionaryModel>Text}" />
        </ComboBox>

        <Label text="{i18n>lblPkLevel}" labelFor="pkLevel" class="appLabel"/>
        <ComboBox id="pkLevel" selectedKey="{formModel>/PkLevel}"
                  items="{path:'dictionaryModel>/PKLEVEL', parameters:{templateShareable:true}}" width="100%"
                  selectionChange="onPkLevelChange" class="appInput">
          <core:Item key="{dictionaryModel>Code}" text="{dictionaryModel>Text}" />
        </ComboBox>

        <Label text="{i18n>lblProfession}" labelFor="profession" class="appLabel"/>
        <ComboBox id="profession" selectedKey="{formModel>/Profession}"
                  items="{path:'dictionaryModel>/PROFESSION', parameters:{templateShareable:true}}" width="100%" class="appInput">
          <core:Item key="{dictionaryModel>Code}" text="{dictionaryModel>Text}" />
        </ComboBox>

        <!-- [Fix SSOT] maxLength — constraintsModel (EntityConfig.CONSTRAINTS),
             единственный источник, зеркалящий CheckRoots.Equipment MaxLength="100"
             из metadata.xml, вместо независимого литерала здесь. -->
        <Label text="{i18n>lblEquipment}" labelFor="equipment" class="appLabel"/>
        <Input id="equipment"
               value="{formModel>/Equipment}"
               placeholder="{i18n>phEquipment}"
               maxLength="{constraintsModel>/EquipmentMaxLength}"
               class="appInput"/>

        <Label text="{i18n>lblLocation}" labelFor="locationInput" class="appLabel"/>
        <VBox class="appLocationVBox">
          <Input id="locationInput"
                 value="{formModel>/LocationText}"
                 placeholder="{i18n>phLocationSelect}"
                 showValueHelp="true"
                 valueHelpRequest="onLocationValueHelp"
                 width="100%" class="appInput"/>
          <Text id="locationPath" text="{formModel>/LocationPath}"
                class="appLocationPath" wrapping="true"
                visible="{= !!${formModel>/LocationPath} }"/>
        </VBox>
      </f:content>
    </f:SimpleForm>

    <MessageStrip
      text="{i18n>hintBarriers}"
      type="Information" showIcon="true"
      class="appHintStrip"
      visible="{= !${formModel>/BarriersAllowed} }"/>
  </Panel>

</core:FragmentDefinition>
