<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:f="sap.ui.layout.form"
  xmlns:core="sap.ui.core">

  <!-- [Fix UX, по просьбе] Без Panel-карточки — см. StepWhenWhere.fragment.xml. -->
  <f:SimpleForm id="professionPkForm"
                  editable="true"
                  layout="ResponsiveGridLayout"
                  columnsL="2" columnsM="2" columnsXL="3"
                  singleContainerFullSize="true"
                  class="appForm">
      <f:content>
        <Label text="{i18n>lblPkLevel}" labelFor="pkLevel" class="appLabel"/>
        <!-- [Fix FN-04/WZ-03/SF-01/UX-12] Select, а не ComboBox: у ComboBox каждое
             нажатие клавиши (Backspace, typeahead) слало selectionChange и сносило
             строки. forceSelection="false" — иначе пустой PkLevel молча стал бы "0". -->
        <Select id="pkLevel" selectedKey="{formModel>/PkLevel}" forceSelection="false"
                items="{path:'dictionaryModel>/PKLEVEL', parameters:{templateShareable:true}}" width="100%"
                change="onPkLevelChange" class="appInput">
          <core:Item key="{dictionaryModel>Code}" text="{dictionaryModel>Text}" />
        </Select>

        <Label text="{i18n>lblProfession}" labelFor="profession" class="appLabel"/>
        <ComboBox id="profession" selectedKey="{formModel>/Profession}"
                  items="{path:'dictionaryModel>/PROFESSION', parameters:{templateShareable:true}}" width="100%" class="appInput">
          <core:Item key="{dictionaryModel>Code}" text="{dictionaryModel>Text}" />
        </ComboBox>

        <!-- [Fix SSOT] maxLength — constraintsModel (EntityConfig.CONSTRAINTS),
             единственный источник, зеркалящий CheckRoots.Equipment MaxLength="100"
             из metadata.xml, вместо независимого литерала здесь. -->
        <Label text="{i18n>lblEquipment}" labelFor="equipment" class="appLabel"/>
        <Input id="equipment"
               value="{formModel>/Equipment}"
               placeholder="{i18n>phEquipment}"
               maxLength="{constraintsModel>/EquipmentMaxLength}"
               class="appInput"/>
      </f:content>
  </f:SimpleForm>

  <!-- [Fix, аудит] Подсказка про видимость барьеров убрана отсюда — она же
       дублировалась дословно на самом шаге "Барьеры" (BarriersTable.fragment.xml),
       где она и уместнее (там, где реально виден пустой раздел), а не здесь
       заранее. -->

</core:FragmentDefinition>
